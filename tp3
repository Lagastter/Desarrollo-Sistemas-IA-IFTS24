    "preprocesador = ColumnTransformer([\n",
    "    ('num', Pipeline([('imputar', SimpleImputer(strategy='median')),\n",
    "                      ('escalar', StandardScaler())]), numericas),\n",
    "    ('cat', Pipeline([('imputar', SimpleImputer(strategy='constant', fill_value='No informado')),\n",
